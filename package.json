{
  "name": "k1frx-morse-trainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "K1FRX Morse Trainer — web-first CW learning app (Koch progression, Farnsworth timing, adaptive review).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude \"src/**/*.benchmark.test.ts\"",
    "test:watch": "vitest",
    "benchmark:data": "vitest run src/data/benchmark-100k.benchmark.test.ts"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.11.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.11.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
